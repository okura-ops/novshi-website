---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';
import { PROPERTIES } from '../data/properties';

const recruitItems = [
  { title: '採用戦略の設計', desc: '誰を、いつまでに、いくらで採るかを数字で決めます。' },
  { title: '求人原稿の作成', desc: '入社後を想像できる粒度で仕事と待遇を書きます。' },
  { title: '媒体運用', desc: 'Indeed・Meta広告・採用HPを応募単価で配分します。' },
  { title: '面接の設計と同席', desc: '評価項目を先に揃えます。同席もできます。' },
  { title: '内定から入社まで', desc: '辞退が出やすい局面で先に動きます。' },
  { title: '定着支援', desc: '入社後1・3・6か月を目安に面談します。' },
];
const channels = [
  { num: '01', label: 'Indeed', desc: '仕事を探す人の検索結果に載る、応募獲得の中心媒体です。' },
  { num: '02', label: 'Meta広告', desc: '転職を考えはじめる前の層に、求人を先に見せます。' },
  { num: '03', label: '自社採用HP', desc: '社名で検索した応募者の疑問に、一次情報で答える場所です。' },
];
const globalItems = [
  { title: '人材紹介', desc: '職種要件との適合を確認してから紹介します。' },
  { title: '住まいの確保', desc: '社宅として貸せる住居を自社で用意します。空き家再生事業が受け皿です。' },
  { title: '定着フォロー', desc: '入社後の生活相談を受け、気になる変化を企業へ共有します。' },
];
const kaizenItems = [
  { title: '組織づくり', desc: '評価・役割分担・会議体など、人が動く仕組みを整えます。' },
  { title: '業務の仕組み化', desc: '属人化した業務を棚卸しし、手順化からAI活用まで進めます。' },
  { title: '経営の数値管理', desc: '売上・採用・定着の指標を設計し、月次で回る形にします。' },
  { title: '実行支援', desc: '計画づくりで終わらせず、現場での実行まで一緒に担います。' },
];
const troubles = [
  '応募対応が兼任で後回しになり、辞退が続いている',
  '担当者の退職で、採用がそのまま止まっている',
  '媒体に出しても応募が来ず、どこから直すべきか分からない',
  '採用できても住まいが決まらず、入社に至らない（外国人採用）',
];
const steps = [
  { num: '1', title: 'ヒアリング', desc: '採用と組織の現状を伺います。相談は無料です。' },
  { num: '2', title: '支援範囲の設計', desc: '何をどこまで任せるかを文書で確定します。' },
  { num: '3', title: '運用開始', desc: '実務を開始し、月次で数字と論点を報告します。' },
];
---

<Layout title="サービス | 株式会社novshi" description="採用支援・組織改善と、空き家を社宅に変える事業。九州の中小企業の採用と定着を、代表が直接支えます。">
  {/* TODO:COPY services-hero */}
  <Hero label="Services" title="novshiの事業" subtitle="九州の中小企業の採用と組織を支える仕事と、空き家を働く人の社宅に変える仕事をしています。" compact={true} />

  <!-- サービスタブ: 採用・経営支援 ／ 空き家再生 -->
  <div class="bg-white washi border-t border-gray-200 sticky top-16 lg:top-[72px] z-30" id="service-tabs">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="flex gap-10">
        <button type="button" data-tab="shien" class="tab-btn relative py-5 text-base lg:text-lg font-bold text-gray-900 transition-colors duration-200" aria-selected="true">
          採用・経営支援
          <img src="/images/brush/line-sumi.png" alt="" aria-hidden="true" width="1118" height="103" class="tab-ink absolute bottom-0 left-0 w-full h-1.5 object-cover select-none" />
        </button>
        <button type="button" data-tab="akiya" class="tab-btn relative py-5 text-base lg:text-lg font-bold text-text-muted transition-colors duration-200" aria-selected="false">
          空き家再生
          <img src="/images/brush/line-sumi.png" alt="" aria-hidden="true" width="1118" height="103" class="tab-ink absolute bottom-0 left-0 w-full h-1.5 object-cover select-none hidden" />
        </button>
      </div>
    </div>
  </div>



  <div data-panel="shien">
  <!-- 柱1: 採用支援 -->
  <section id="recruitment" class="sec-xl scroll-mt-32 bg-white border-t border-gray-100 washi">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl fade-in-up">
        {/* TODO:COPY services-recruit-head */}
        <p class="font-num text-5xl lg:text-6xl font-medium text-gray-200 leading-none mb-5" aria-hidden="true">01</p>
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-6">採用支援</h2>
        <p class="text-lg font-bold text-gray-900 mb-4">「もう一人の経営者。」</p>
        {/* TODO:COPY services-recruit-lead */}
        <p class="text-text-secondary leading-[1.9]">
          採用担当がいない会社の、採用担当になります。実務代行ではなく、経営者の隣で採否を一緒に決める立場です。
        </p>
      </div>

      <!-- 戦略の階層: 採用戦略は事業戦略→組織戦略の順でしか立てられない -->
      <div class="mt-14 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 fade-in-up">
          <h3 class="text-xl lg:text-2xl font-bold text-gray-900 mb-5">採用は、経営から逆算する</h3>
          <p class="text-sm text-text-secondary leading-[1.9] max-w-md">
            採用戦略は、単独では立てられません。事業戦略が決まり、それを実行する組織のかたちが決まって、はじめて「誰を、いつ採るか」が決まります。この順番を飛ばした求人は、応募が来ても定着しません。
          </p>
          <p class="mt-4 text-sm text-text-secondary leading-[1.9] max-w-md">
            だからnovshiの採用支援は、経営・事業のレイヤーに立てるメンバーのみで行います。求人の書き方ではなく、事業の勝ち筋から採用を設計します。
          </p>
        </div>
        <div class="lg:col-span-7 fade-in-up" role="img" aria-label="事業戦略、組織戦略、採用戦略の順に決まる階層図。novshiは3層すべてを支援範囲とする">
          <div class="max-w-xl mx-auto">
            <div class="flex items-stretch gap-5">
              <div class="flex-1">
                <div class="bg-[#1A1A1A] px-6 py-5 lg:px-8">
                  <p class="text-[11px] text-white/50 mb-1"><span class="font-num">1</span></p>
                  <p class="text-base lg:text-lg font-bold text-white">事業戦略</p>
                  <p class="mt-1 text-xs text-white/65">どの市場で、何で勝つか</p>
                </div>
                <div class="bg-[#4D4D4D] px-6 py-5 lg:px-8 w-[86%]">
                  <p class="text-[11px] text-white/50 mb-1"><span class="font-num">2</span></p>
                  <p class="text-base lg:text-lg font-bold text-white">組織戦略</p>
                  <p class="mt-1 text-xs text-white/70">どんな組織と役割で実行するか</p>
                </div>
                <div class="bg-[#8A8A8A] px-6 py-5 lg:px-8 w-[72%]">
                  <p class="text-[11px] text-white/60 mb-1"><span class="font-num">3</span></p>
                  <p class="text-base lg:text-lg font-bold text-white">採用戦略</p>
                  <p class="mt-1 text-xs text-white/75">誰を、いつ、どう採るか</p>
                </div>
              </div>
              <div class="flex flex-col items-center shrink-0 pt-1 pb-1">
                <img src="/images/brush/line-sumi.png" alt="" aria-hidden="true" class="h-full w-2 object-cover select-none" style="object-position: center;" />
              </div>
              <div class="flex items-center shrink-0">
                <p class="text-sm font-bold text-gray-900" style="writing-mode: vertical-rl; letter-spacing: 0.18em;">novshiの支援範囲</p>
              </div>
            </div>
            <p class="mt-4 text-xs text-text-muted">採用戦略は、この順番でしか立てられません。</p>
          </div>
        </div>
      </div>

      <div class="max-w-2xl">
        {/* 課題の言語化（RPOサービスページの定石: 悩みを先に置く） */}
        <div class="mt-10">
          <p class="text-sm font-bold text-gray-900 mb-4">こんな状態の会社を支えています</p>
          <ul class="space-y-2.5 text-sm text-text-secondary leading-[1.8]">
            {troubles.map((t) => (
              <li class="pl-5 relative before:content-['—'] before:absolute before:left-0 before:text-gray-400">{t}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-12 stagger">
        {recruitItems.map((item) => (
          <div class="border-t border-gray-200 py-6">
            <h3 class="text-sm font-bold text-gray-900 mb-1">{item.title}</h3>
            <p class="text-sm text-text-secondary leading-[1.9]">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- 役割分担の対比（委託できる範囲を先に見せる） -->
      <div class="mt-16 pt-12 border-t border-gray-200">
        <h3 class="text-xl font-bold text-gray-900 mb-8 fade-in-up">役割分担</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 max-w-4xl fade-in-up">
          <div class="bg-[#1A1A1A] p-8 lg:p-9">
            <p class="text-sm font-bold text-white mb-5">novshiが担うこと</p>
            <ul class="space-y-3 text-sm text-white/80 leading-[1.8]">
              <li>採用戦略の設計と数値目標づくり</li>
              <li>求人原稿の作成・改稿とA/Bテスト</li>
              <li>媒体運用と応募単価の管理</li>
              <li>面接の設計、応募者への連絡</li>
              <li>内定後のフォローと定着面談</li>
            </ul>
          </div>
          <div class="bg-[#F2F2F2] p-8 lg:p-9">
            <p class="text-sm font-bold text-gray-900 mb-5">お客様にお願いすること</p>
            <ul class="space-y-3 text-sm text-text-secondary leading-[1.8]">
              <li>採否の最終決定</li>
              <li>労働条件・待遇の決定</li>
              <li>面接の実施（novshiの同席は可能です）</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 運用する3つのチャネル: 均等3カラムカードをやめて行リストに -->
      <div class="mt-16 pt-12 border-t border-gray-200">
        {/* TODO:COPY services-recruit-channels-head */}
        <h3 class="text-xl font-bold text-gray-900 mb-2 fade-in-up">運用する3つのチャネル</h3>
        <p class="text-text-secondary mb-8 fade-in-up">媒体ごとに役割を分けて使います。</p>
        <div class="stagger max-w-3xl">
          {channels.map((ch) => (
            <div class="grid grid-cols-[3.5rem_10rem_1fr] max-sm:grid-cols-[3.5rem_1fr] items-baseline gap-3 py-5 border-b border-gray-200">
              <span class="font-num text-2xl font-medium text-gray-300">{ch.num}</span>
              <p class="text-base font-bold text-gray-900">{ch.label}</p>
              <p class="text-sm text-text-secondary leading-[1.9] max-sm:col-span-2 max-sm:pl-14">{ch.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- 進め方: 3ステップ（複雑さを見せない） -->
      <div class="mt-16 pt-12 border-t border-gray-200">
        <h3 class="text-xl font-bold text-gray-900 mb-8 fade-in-up">ご依頼から開始まで</h3>
        <div class="flex flex-col md:flex-row md:items-stretch gap-y-6 max-w-4xl stagger">
          {steps.map((s, i) => (
            <>
              {i > 0 && <div class="hidden md:flex items-center px-4 text-gray-300 text-xl" aria-hidden="true">→</div>}
              <div class="flex-1 pt-5">
                <img src="/images/brush/line-sumi.png" alt="" aria-hidden="true" width="1118" height="103" class="brush-rule h-2 mb-5 select-none" />
                <p class="font-num text-2xl font-medium text-gray-300 leading-none mb-3">{s.num}</p>
                <p class="text-base font-bold text-gray-900">{s.title}</p>
                <p class="mt-2 text-sm text-text-secondary leading-[1.8]">{s.desc}</p>
              </div>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 外国人採用・定着支援 -->
  <section class="sec-lg bg-bg-secondary washi">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-3xl fade-in-up">
        <h3 class="text-xl font-bold text-gray-900 mb-4">外国人採用・定着支援</h3>
        {/* TODO:COPY services-global-lead */}
        <p class="text-text-secondary leading-[1.9] mb-8 max-w-xl">
          外国人採用でよくあるつまずきは、内定後に住まいが決まらないことです。novshiは人材紹介（有料職業紹介事業許可 40-ユ-301708）に、社宅の用意を組み合わせています。
        </p>
        <div class="stagger">
          {globalItems.map((item) => (
            <div class="border-t border-gray-300/70 py-5">
              <h4 class="text-sm font-bold text-gray-900 mb-1">{item.title}</h4>
              <p class="text-sm text-text-secondary leading-[1.9] max-w-lg">{item.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-[#1A1A1A] rounded-none hover:opacity-85 transition-opacity duration-200">相談する</a>
          <a href="/contact?type=doc" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-gray-900 border border-gray-900 rounded-none hover:bg-[#F2F2F2] transition-colors duration-200">資料を請求する</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 柱2: 組織・事業・経営の改善支援 -->
  <section id="consulting" class="sec-lg bg-white scroll-mt-20 washi">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 fade-in-up">
          {/* TODO:COPY services-kaizen-head */}
          <p class="font-num text-5xl lg:text-6xl font-medium text-gray-200 leading-none mb-5" aria-hidden="true">02</p>
          <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-6">組織・事業・経営の改善支援</h2>
          {/* TODO:COPY services-kaizen-lead */}
          <p class="text-text-secondary leading-[1.9] max-w-xl">
            人を起点に、組織・事業・経営の課題を整理し、改善の実行まで担います。入り口はほとんどの場合、採用です。人が採れない理由を追いかけると、評価の仕組みや業務の回し方、投資判断の順序に行き着きます。novshiはそこまで一緒に踏み込みます。
          </p>
        </div>
        <div class="lg:col-span-5 fade-in-up">
          <!-- 同心円図: 人を起点に組織・事業・経営へ広がる -->
          <!-- 同心円: 購入した筆致円相（実スキャン由来）3輪で構成（Web DS v1.1 §4-2） -->
          <svg viewBox="0 0 520 470" class="w-full max-w-sm mx-auto" role="img" aria-label="中心の「人」を、組織・事業・経営の3つの筆致の円が囲む図">
            <image href="/images/brush/enso-3-g300.png" x="35" y="35" width="450" height="425" />
            <image href="/images/brush/enso-5-g500.png" x="105" y="105" width="310" height="288" />
            <image href="/images/brush/enso-1.png" x="172" y="170" width="176" height="166" />
            <circle cx="260" cy="250" r="42" fill="#1A1A1A" />
            <text x="260" y="259" font-size="22" font-weight="bold" fill="#fff" text-anchor="middle">人</text>
          </svg>
          <div class="mt-6 max-w-sm mx-auto space-y-2.5">
            <p class="text-sm leading-[1.8]"><span class="font-bold text-gray-900">● 組織</span><span class="text-text-secondary">　評価・役割・定着</span></p>
            <p class="text-sm leading-[1.8]"><span class="font-bold" style="color:#8A8A8A">● 事業</span><span class="text-text-secondary">　業務・営業・仕組み化</span></p>
            <p class="text-sm leading-[1.8]"><span class="font-bold" style="color:#C0C0C0">● 経営</span><span class="text-text-secondary">　数値管理・投資判断</span></p>
          </div>
          
        </div>
      </div>

      <div class="mt-12 stagger max-w-3xl">
        {kaizenItems.map((item) => (
          <div class="border-t border-gray-200 py-6">
            <h3 class="text-sm font-bold text-gray-900 mb-1">{item.title}</h3>
            <p class="text-sm text-text-secondary leading-[1.9]">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- 支援の実例（守秘のため業種のみ） -->
      <div class="mt-16 pt-12 border-t border-gray-200">
        <h3 class="text-xl font-bold text-gray-900 mb-2 fade-in-up">支援の実例</h3>
        <p class="text-sm text-text-muted mb-8 fade-in-up">守秘のため、社名を伏せて業種のみ記載しています。</p>
        <div class="stagger max-w-3xl">
          <div class="border-t border-gray-200 py-6">
            <p class="text-sm font-bold text-gray-900 mb-1">不動産会社 — 採用から、人事制度の設計へ</p>
            <p class="text-sm text-text-secondary leading-[1.9]">採用支援として始まり、応募者管理の仕組み（通知の自動化・管理シート）と人事制度の設計まで担当しています。</p>
          </div>
          <div class="border-t border-gray-200 py-6">
            <p class="text-sm font-bold text-gray-900 mb-1">求人メディア運営会社 — 営業部門の立て直しへ</p>
            <p class="text-sm text-text-secondary leading-[1.9]">支社の営業立て直しプロジェクトに外部アドバイザーとして参画。営業データの整備と、月次で数字を追う会議体を設計しています。</p>
          </div>
          <div class="border-t border-gray-200 py-6">
            <p class="text-sm font-bold text-gray-900 mb-1">ITコンサルティング会社 — 採用投資の意思決定へ</p>
            <p class="text-sm text-text-secondary leading-[1.9]">高額な採用媒体に出稿する前に、無料チャネルで応募の集まり方を検証する設計に変更。数字が出てから投資を判断する形にしました。</p>
          </div>
        </div>
      </div>

      {/* TODO:COPY services-kaizen-price-note */}
      <p class="mt-10 text-sm text-text-muted leading-relaxed">
        内容と範囲を確認したうえで、個別に見積もります。
      </p>
    </div>
  </section>

  </div>

  <div data-panel="akiya" class="hidden">
  <!-- 空き家再生×社宅 -->
  <section id="akiya" class="sec-xl scroll-mt-32 bg-white washi washi-seigaiha">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl fade-in-up">
        {/* TODO:COPY services-akiya-head */}
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-6">空き家再生×社宅</h2>
        {/* TODO:COPY services-akiya-lead */}
        <p class="text-text-secondary leading-[1.9]">
          空き家を買い取り、改修し、介護・建設・飲食の現場で働く人や外国人材の社宅として長期で貸します。物件の情報は、採用支援で付き合いのある地場企業から届きます。社宅は採用した人材の定着に使われます。
        </p>
      </div>

      <!-- 物件一覧: 情報として掲載（募集中／稼働中のみ。正本=Notion取得物件管理DB） -->
      <div class="mt-14">
        <h3 class="text-xl font-bold text-gray-900 mb-8 fade-in-up">物件情報</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10 stagger">
          {PROPERTIES.map((p) => (
            <div class="flex flex-col">
              <div class="relative">
                {p.img ? (
                  <img src={`/images/site/${p.img}.webp`} alt={p.alt} class="w-full aspect-[4/3] object-cover" loading="lazy" width="800" height="600" />
                ) : (
                  <div class="relative w-full aspect-[4/3] bg-[#1A1A1A] overflow-hidden">
