---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout title="サービス | 株式会社novshi" description="採用支援とBPO。九州の中小企業の採用と、その周辺業務を月額で引き受けます。">
  {/* TODO:COPY services-hero */}
  <Hero title="求人づくりから入社後の定着まで、月額で。" subtitle="九州の中小企業の採用と、その周辺の業務まで担います。「採用支援」と「BPO」の二本柱です。" compact={true} />

  <!-- 3 Channel -->
  <section class="py-20 lg:py-24 bg-bg-secondary">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      {/* TODO:COPY services-channels-intro */}
      <h2 class="text-2xl font-bold text-gray-900 mb-4 fade-in-up">3つの入り口で、応募を増やす</h2>
      <p class="text-text-secondary mb-12 fade-in-up">求職者と出会う入り口を増やし、応募につなげます。</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger">
        {[
          { label: 'Indeed', num: '01', desc: 'スポンサー求人の単価を調整し、応募単価を抑えます' },
          { label: 'Meta広告', num: '02', desc: 'Instagram・Facebookで、転職をまだ考えていない人に届けます' },
          { label: '自社採用HP', num: '03', desc: '検索されやすい構造で、求職者に見つかる採用ページをつくります' },
        ].map((ch) => (
          <div class="bg-white p-8 lg:p-10 rounded-xl border border-gray-200 card-lift">
            <span class="font-num inline-flex items-center justify-center w-9 h-9 rounded-md bg-[#F2F2F2] text-sm font-bold text-gray-900 mb-5">{ch.num}</span>
            <p class="text-base font-bold text-gray-900 mb-2">{ch.label}</p>
            <p class="text-sm text-text-secondary leading-[1.9]">{ch.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 柱1: 採用支援 -->
  <section id="recruitment" class="py-24 lg:py-32 scroll-mt-20 bg-white">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-16 items-start">
        <div>
          <div class="fade-in-up">
            <p class="font-display text-xs font-semibold text-text-muted uppercase tracking-[0.15em] mb-4">Service 01</p>
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-6">採用支援</h2>
            {/* TODO:COPY services-recruitment-lead */}
            <p class="text-lg font-bold text-gray-900 mb-4">「もう一人の経営者。」</p>
            <p class="text-text-secondary leading-[1.9]">
              求人を出すだけでは、人は来ません。誰に何をどう届けるかを一緒に決め、面接、入社後の定着まで担当します。採用と組織づくりを、月額で一緒に進めます。
            </p>
          </div>

          <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-y-8 gap-x-12 stagger">
            {[
              { title: 'EVP（採用の強み）の言語化', desc: '自社が選ばれる理由を整理し、求職者に伝わる言葉にします。' },
              { title: '求人原稿の作成', desc: '媒体ごとに刺さる求人原稿を書き、検索と応募につなげます。' },
              { title: 'Indeed運用代行', desc: 'スポンサー求人の単価調整、A/Bテスト、効果測定をまとめて代行します。' },
              { title: 'Meta広告運用', desc: 'Instagram・Facebookの採用広告を、クリエイティブ制作から運用まで。' },
              { title: '採用HPの構築・運用', desc: '検索されやすい構造の採用サイトを構築し、運用します。' },
              { title: '採用KPIの管理', desc: '応募数・表示数・CTR・CPAを見える化し、数字を見て打ち手を変えます。' },
            ].map((item) => (
              <div class="border-l-2 border-gray-200 pl-6">
                <h3 class="text-sm font-bold text-gray-900 mb-1">{item.title}</h3>
                <p class="text-sm text-text-secondary leading-[1.9]">{item.desc}</p>
              </div>
            ))}
          </div>

          <!-- 外国人採用（採用支援の中に内包） -->
          <div class="mt-16 pt-12 border-t border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-4 fade-in-up">外国人採用・定着支援</h3>
            {/* TODO:COPY services-global-lead */}
            <p class="text-text-secondary leading-[1.9] fade-in-up mb-8">
              外国人材は「紹介して終わり」ではありません。住まい・在留資格・生活の立ち上げまで支え、長く働ける状態をつくります。
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 stagger">
              {[
                { title: '住居付き人材紹介', desc: '空き家再生と組み合わせ、住まいとセットで人材を紹介します。（有料職業紹介事業許可 40-ユ-301708）', note: '空き家事業と連携' },
                { title: '住宅確保支援', desc: '安心して暮らせる住まいを確保。保証人・契約まわりもサポートします。', note: '空き家事業と連携' },
                { title: '在留資格・行政手続サポート', desc: 'ビザの取得・更新、各種届出など、煩雑な手続きをサポートします。', note: null },
                { title: '定着支援', desc: '生活の立ち上げ、日本語、文化への慣れまで支え、長期の定着を後押しします。', note: null },
              ].map((item) => (
                <div class="bg-white p-8 border border-gray-200 rounded-xl card-lift">
                  <div class="flex items-start justify-between mb-3">
                    <h4 class="text-sm font-bold text-gray-900">{item.title}</h4>
                    {item.note && <span class="text-[10px] font-medium text-gray-900 bg-[#F2F2F2] px-2 py-0.5 rounded-full whitespace-nowrap ml-2">{item.note}</span>}
                  </div>
                  <p class="text-sm text-text-secondary leading-[1.9]">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>

          {/* TODO:COPY services-ai-note */}
          <p class="mt-10 text-sm text-text-muted leading-relaxed">
            これらの業務は、AIを道具として使いながら、速く正確に処理しています。
          </p>
        </div>

        <!-- Photo slot -->
        <div class="hidden lg:block fade-in-up">
          <PhotoSlot mode="placeholder" label="採用支援" aspect="aspect-[3/4]" class="sticky top-24" />
        </div>
      </div>
    </div>
  </section>

  <!-- 柱2: BPO -->
  <section id="bpo" class="py-24 lg:py-32 bg-bg-secondary scroll-mt-20">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-16 items-start">
        <!-- Photo slot -->
        <div class="hidden lg:block fade-in-up">
          <PhotoSlot mode="placeholder" label="BPO" aspect="aspect-[3/4]" class="sticky top-24" />
        </div>

        <div>
          <div class="fade-in-up">
            <p class="font-display text-xs font-semibold text-text-muted uppercase tracking-[0.15em] mb-4">Service 02</p>
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-6">BPO（業務運用代行）</h2>
            {/* TODO:COPY services-bpo-lead */}
            <p class="text-text-secondary leading-[1.9]">
              人手が足りず止まっている業務、担当者が辞めて動かなくなった業務を引き受けます。採用まわりを中心に、月額でお預かりし、実務を止めずに進めます。
            </p>
          </div>

          <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 gap-6 stagger">
            {[
              { title: '採用事務・応募対応', desc: '応募者への連絡、日程調整、選考の事務まわりを代行します。' },
              { title: '人事労務・バックオフィス', desc: '入退社手続き、勤怠、各種事務の定型業務を代行します。' },
              { title: 'カスタマーサポート', desc: '問い合わせ対応など、止められない業務を安定して続けます。' },
              { title: '月次レポート・改善提案', desc: '業務量と品質を見える化し、毎月の改善につなげます。' },
            ].map((item) => (
              <div class="bg-white p-8 border border-gray-200 rounded-xl card-lift">
                <h3 class="text-sm font-bold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-sm text-text-secondary leading-[1.9]">{item.desc}</p>
              </div>
            ))}
          </div>

          {/* TODO:COPY services-bpo-price */}
          <p class="mt-10 text-sm text-text-muted leading-relaxed">
            月額制・個別お見積り。まずは業務の棚卸しから始めます。
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
