---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';
import { PROPERTIES } from '../data/properties';

const recruitItems = [
  { title: '採用戦略の設計', desc: '誰を、いつまでに、いくらで採るか。まず数字で決めます。' },
  { title: '求人原稿の作成', desc: '応募者が入社後を想像できる粒度で、仕事と待遇を書きます。' },
  { title: '媒体運用', desc: 'Indeed・Meta広告・自社採用HPの3つを、応募単価を見ながら配分します。' },
  { title: '面接の設計と同席', desc: '評価項目を先に揃え、求めがあれば面接にも同席します。' },
  { title: '内定から入社まで', desc: '条件提示から入社日まで連絡を切らさず、辞退が出やすい局面で先に動きます。' },
  { title: '定着支援', desc: '入社後1・3・6か月を目安に面談し、離職の兆候を経営者へ伝えます。' },
];
const channels = [
  { num: '01', label: 'Indeed', desc: '仕事を探す人の検索結果に載る、応募獲得の中心媒体です。' },
  { num: '02', label: 'Meta広告', desc: '転職を考えはじめる前の層に、求人を先に見せます。' },
  { num: '03', label: '自社採用HP', desc: '社名で検索した応募者の疑問に、一次情報で答える場所です。' },
];
const globalItems = [
  { title: '人材紹介', desc: '職種要件と在留資格の適合を確認してから紹介します。' },
  { title: '在留資格支援', desc: '必要書類と手続きを、入社日から逆算した工程表にします。' },
  { title: '住まいの確保', desc: '社宅として貸せる住居を自社で用意します。空き家再生事業が受け皿です。' },
  { title: '定着フォロー', desc: '入社後の生活相談を受け、気になる変化を企業へ共有します。' },
];
const bpoItems = [
  { title: '応募者への連絡代行', desc: '応募への一次連絡と面接日程の調整を、依頼元の企業名義で行います。' },
  { title: '求人媒体の運用代行', desc: '原稿の更新と広告費の配分を、応募状況に合わせて見直します。' },
  { title: '採用事務', desc: '内定通知や入社書類など、書類まわりの作成と送付を担います。' },
  { title: 'その他の定型業務', desc: '請求書発行やデータ入力など、採用以外も相談できます。' },
];
---

<Layout title="サービス | 株式会社novshi" description="採用支援・BPOと、空き家を社宅に変える事業。九州の中小企業の採用と定着を、代表が直接支えます。">
  {/* TODO:COPY services-hero */}
  <Hero label="Services" title="novshiのふたつの事業" subtitle="novshiは、九州の中小企業の採用支援・BPOと、空き家を社宅に変える事業を並行しています。顧客は共通です。採用支援の顧客が空き家の情報をもたらし、社宅は採用した人の住まいになります。" compact={true} />

  <!-- 柱1: 採用支援 -->
  <section id="recruitment" class="sec-xl scroll-mt-20 bg-white border-t border-gray-100">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl fade-in-up">
        {/* TODO:COPY services-recruit-head */}
        <p class="eyebrow text-text-muted mb-4">Service 01</p>
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-6">採用支援</h2>
        <p class="text-lg font-bold text-gray-900 mb-4">「もう一人の経営者。」</p>
        {/* TODO:COPY services-recruit-lead */}
        <p class="text-text-secondary leading-[1.9]">
          採用担当がいない会社の、採用担当になります。実務代行ではなく、経営者の隣で採否を一緒に決める立場です。担当は代表・大倉。丸紅で事業投資を経験し、リクルートで<span class="font-num text-gray-900">6</span>年、中途採用営業とIndeedの事業企画として<span class="font-num text-gray-900">1,000</span>社以上の採用に関わりました。
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-12 stagger">
        {recruitItems.map((item) => (
          <div class="border-t border-gray-200 py-6">
            <h3 class="text-sm font-bold text-gray-900 mb-1">{item.title}</h3>
            <p class="text-sm text-text-secondary leading-[1.9]">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- 運用する3つのチャネル: 均等3カラムカードをやめて行リストに -->
      <div class="mt-16 pt-12 border-t border-gray-200">
        {/* TODO:COPY services-recruit-channels-head */}
        <h3 class="text-xl font-bold text-gray-900 mb-2 fade-in-up">運用する3つのチャネル</h3>
        <p class="text-text-secondary mb-8 fade-in-up">媒体ごとに役割を分けて使います。</p>
        <div class="stagger max-w-3xl">
          {channels.map((ch) => (
            <div class="grid grid-cols-[3rem_10rem_1fr] max-sm:grid-cols-[3rem_1fr] items-baseline gap-3 py-5 border-b border-gray-200">
              <span class="font-num text-sm text-text-muted">{ch.num}</span>
              <p class="text-base font-bold text-gray-900">{ch.label}</p>
              <p class="text-sm text-text-secondary leading-[1.9] max-sm:col-span-2 max-sm:pl-12">{ch.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 外国人採用・定着支援 -->
  <section class="sec-lg bg-bg-secondary">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-3xl fade-in-up">
        <h3 class="text-xl font-bold text-gray-900 mb-4">外国人採用・定着支援</h3>
        {/* TODO:COPY services-global-lead */}
        <p class="text-text-secondary leading-[1.9] mb-8 max-w-xl">
          外国人採用でよくあるつまずきは、内定後に住まいが決まらないことです。novshiは人材紹介（有料職業紹介事業許可 40-ユ-301708）に、在留資格手続きの支援と社宅の用意を組み合わせています。
        </p>
        <div class="stagger">
          {globalItems.map((item) => (
            <div class="border-t border-gray-300/70 py-5">
              <h4 class="text-sm font-bold text-gray-900 mb-1">{item.title}</h4>
              <p class="text-sm text-text-secondary leading-[1.9] max-w-lg">{item.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-[#1A1A1A] rounded-md hover:opacity-85 transition-opacity duration-200">相談する</a>
          <a href="/contact?type=doc" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-gray-900 border border-gray-900 rounded-md hover:bg-[#F2F2F2] transition-colors duration-200">資料を請求する</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 柱2: BPO -->
  <section id="bpo" class="sec-lg bg-white scroll-mt-20">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl fade-in-up">
        {/* TODO:COPY services-bpo-head */}
        <p class="eyebrow text-text-muted mb-4">Service 02</p>
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-6">BPO</h2>
        {/* TODO:COPY services-bpo-lead */}
        <p class="text-text-secondary leading-[1.9]">
          担当者の退職や兼任で止まった業務を、月額で請け負います。中心は採用まわりです。範囲は事前に文書で確定します。
        </p>
      </div>

      <div class="mt-12 stagger max-w-3xl">
        {bpoItems.map((item) => (
          <div class="border-t border-gray-200 py-6">
            <h3 class="text-sm font-bold text-gray-900 mb-1">{item.title}</h3>
            <p class="text-sm text-text-secondary leading-[1.9]">{item.desc}</p>
          </div>
        ))}
      </div>

      {/* TODO:COPY services-bpo-price-note */}
      <p class="mt-10 text-sm text-text-muted leading-relaxed">
        月額<span class="font-num">10</span>万円から。業務の範囲と量を確認したうえで見積もります。
      </p>
    </div>
  </section>

  <!-- 柱3: 空き家再生×社宅（準備・実証フェーズ） -->
  <section id="akiya" class="sec-xl scroll-mt-20 bg-white">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl fade-in-up">
        {/* TODO:COPY services-akiya-head */}
        <p class="eyebrow text-text-muted mb-4">Service 03 / 準備・実証フェーズ</p>
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-6">空き家再生×社宅</h2>
        {/* TODO:COPY services-akiya-lead */}
        <p class="text-text-secondary leading-[1.9]">
          空き家を買い取り、改修し、介護・建設・飲食の現場で働く人や外国人材の社宅として長期で貸します。物件の情報は、採用支援で付き合いのある地場企業から届きます。社宅は採用した人材の定着に使われます。
        </p>
      </div>

      <!-- 物件一覧: 情報として掲載（募集中／稼働中のみ。正本=Notion取得物件管理DB） -->
      <div class="mt-14">
        <h3 class="text-xl font-bold text-gray-900 mb-8 fade-in-up">物件情報</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger">
          {PROPERTIES.map((p) => (
            <div class="bg-white border border-gray-200 card-lift flex flex-col">
              {p.img ? (
                <img src={`/images/site/${p.img}.webp`} alt={p.alt} class="w-full aspect-[4/3] object-cover" loading="lazy" width="800" height="600" />
              ) : (
                <div class="relative w-full aspect-[4/3] bg-[#1A1A1A] overflow-hidden">
                  <img aria-hidden="true" src="/images/site/mark-enso-white.png" alt="" width="888" height="981" class="absolute -right-[16%] -bottom-[40%] w-[240px] max-w-none opacity-[0.12] select-none pointer-events-none" loading="lazy" />
                </div>
              )}
              <div class="p-5 flex items-start justify-between gap-3">
                <div>
                  <p class="text-sm font-bold text-gray-900">{p.name}</p>
                  {p.spec && <p class="mt-1 text-xs text-text-muted">{p.spec}</p>}
                </div>
                <span class:list={[
                  'shrink-0 text-[11px] font-semibold px-2.5 py-1 rounded-sm',
                  p.status === '募集中' ? 'bg-[#1A1A1A] text-white' : 'bg-[#F2F2F2] text-text-secondary',
                ]}>{p.status}</span>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs text-text-muted fade-in-up">賃料・入居条件は物件ごとに異なります。最新の空き状況はLINEでお答えします。</p>
      </div>

      <div class="mt-10 border border-gray-200 p-6 max-w-xl fade-in-up">
        <p class="text-sm font-bold text-gray-900 mb-2">入居をお考えの個人の方へ</p>
        <p class="text-sm text-text-secondary leading-[1.9]">
          募集中の物件の内覧予約・空き状況は、LINEまたはお問い合わせフォームからご連絡ください。
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="https://lin.ee/Ylj7svr" target="_blank" rel="noopener" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-[#06C755] rounded-md hover:opacity-85 transition-opacity duration-200">LINEで相談する</a>
          <a href="/contact" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-gray-900 border border-gray-900 rounded-md hover:bg-[#F2F2F2] transition-colors duration-200">フォームで問い合わせる</a>
        </div>
      </div>

      {/* TODO:COPY services-ai-note */}
      <p class="mt-12 pt-8 border-t border-gray-200 text-sm text-text-muted leading-relaxed max-w-xl fade-in-up">
        novshiは社員ゼロで運営しています。定型業務はAIに任せ、判断と対話は代表・大倉が行います。
      </p>
    </div>
  </section>

  <CTASection />
</Layout>
