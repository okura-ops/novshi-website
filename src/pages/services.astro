  <CTASection />

  <script>
    // サービスタブ切替（#recruitment/#consulting=採用・経営支援、#akiya=空き家再生）
    const btns = document.querySelectorAll('.tab-btn');
    const panels: Record<string, HTMLElement | null> = {
      shien: document.querySelector('[data-panel="shien"]'),
      akiya: document.querySelector('[data-panel="akiya"]'),
    };
    function select(tab: string, scrollTo?: string) {
      btns.forEach((b) => {
        const on = (b as HTMLElement).dataset.tab === tab;
        b.setAttribute('aria-selected', String(on));
        b.classList.toggle('text-gray-900', on);
        b.classList.toggle('text-text-muted', !on);
        b.querySelector('.tab-ink')!.classList.toggle('hidden', !on);
      });
      Object.entries(panels).forEach(([k, el]) => el && el.classList.toggle('hidden', k !== tab));
      if (scrollTo) {
        const t = document.getElementById(scrollTo);
        if (t) t.scrollIntoView({ block: 'start' });
      }
    }
    btns.forEach((b) => b.addEventListener('click', () => select((b as HTMLElement).dataset.tab!)));
    function route() {
      const h = location.hash.replace('#', '');
      if (h === 'akiya') select('akiya', 'akiya');
      else if (h === 'recruitment' || h === 'consulting') select('shien', h);
    }
    route();
    window.addEventListener('hashchange', route);
  </script>
