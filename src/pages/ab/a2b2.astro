---
// A/B試作 a2b2: 見出し=mincho × CTA=cv（判定は経営企画Project。本番導線からリンクしない）
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { IMG } from '../../data/images';
---

<Layout title="AB試作 a2b2 | novshi" noindex={true} minchoFont={true} preloadImage={IMG.heroEngawa.webp}>
  <Hero
    title="豊かさを、描きなおす。"
    subtitle="人が採れない会社の採用を立て直し、空いた家を人が住める家に戻す。九州の「働く」と「住む」を、まとめて引き受けます。"
    showCTA={true}
    headingFont="mincho"
    ctaColor="cv"
  />

  <!-- 白背景でのCTA検証用（コントラスト比確認） -->
  <section class="sec-tight bg-white">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <p class="text-sm text-text-secondary mb-5">白背景でのCTA見え方（AA検証用）</p>
      <a href="#" class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-white bg-[#B5502A] rounded-md">お問い合わせ</a>
    </div>
  </section>
</Layout>
