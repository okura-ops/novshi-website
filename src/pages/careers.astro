---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout title="採用情報 | 株式会社novshi" description="novshiの採用情報。少人数で採用支援・BPOと空き家再生に取り組んでいます。カジュアル面談を受け付けています。">
  <Hero title="novshiで働く" subtitle="少人数で、九州の中小企業の採用と空き家再生に取り組んでいます。" compact={true} />

  <section class="py-24 lg:py-32">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl fade-in-up">
        {/* TODO:COPY careers-intro */}
        <div class="space-y-6 text-text-secondary leading-[1.9]">
          <p>novshiは少人数の会社です。定型業務はAIを使って効率化し、一人が採用支援から空き家再生まで幅広く担っています。</p>
          <p>九州の中小企業の採用を支える採用支援・BPOと、空き家を直して社宅に戻す不動産事業を手がけています。いまは立ち上げの途中です。現場に足を運び、必要なら自分で仕組みをつくれる人を探しています。</p>
        </div>

        <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-6 stagger">
          {[
            { icon: 'M9.594 3.94c.09-.542.56-.94 1.11-.94h.38c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.646.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l.94 1.63a1.125 1.125 0 01-.24 1.41l-.99.816c-.171.1-.27.37-.27.65v.256c0 .28.099.55.27.65l.99.816c.406.335.51.917.24 1.41l-.94 1.63a1.125 1.125 0 01-1.37.49l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.542-.56.94-1.11.94h-.38c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-.94-1.63a1.125 1.125 0 01.24-1.41l.99-.816c.171-.1.27-.37.27-.65v-.256c0-.28-.099-.55-.27-.65l-.99-.816a1.125 1.125 0 01-.24-1.41l.94-1.63a1.125 1.125 0 011.37-.49l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z M15 12a3 3 0 11-6 0 3 3 0 016 0z', label: '少人数×高い裁量', desc: '定型業務はAIで効率化し、一人が判断と対人業務に集中できる体制です' },
            { icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z', label: '裁量の大きさ', desc: '少人数組織だからこそ、一人ひとりの意思決定が事業に直結' },
            { icon: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z', label: '九州拠点', desc: '九州を拠点に、地域の中小企業にサービスを提供' },
          ].map((item) => (
            <div class="bg-white p-8 rounded-xl border border-gray-200">
              <div class="w-10 h-10 rounded-lg bg-navy-50 flex items-center justify-center mb-5">
                <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <p class="text-sm font-bold text-gray-900 mb-2">{item.label}</p>
              <p class="text-xs text-text-secondary leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 lg:py-32 bg-bg-secondary">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl fade-in-up">
        {/* TODO:COPY careers-positions */}
        <h2 class="text-2xl font-bold text-gray-900 mb-6">募集ポジション</h2>
        <p class="text-text-secondary mb-8">具体的な募集ポジションは現在準備中です。カジュアル面談はいつでも受け付けていますので、お気軽にお問い合わせください。</p>
        <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-white bg-accent rounded-lg hover:bg-accent-hover transition-colors duration-200">
          カジュアル面談を申し込む
        </a>
      </div>
    </div>
  </section>

  <CTASection title="novshiに興味がありますか？" subtitle="まずはカジュアルにお話ししましょう。ポジションに関わらず、お気軽にご連絡ください。" />
</Layout>
