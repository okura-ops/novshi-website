---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout title="採用情報 | 株式会社novshi" description="novshiの採用情報。少人数で採用支援・BPOと空き家再生を進めています。カジュアル面談を受け付けています。">
  <Hero title="novshiで働く" subtitle="少人数で、九州の中小企業の採用と空き家再生を進めています。" compact={true} />

  <section class="py-24 lg:py-32">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl fade-in-up">
        {/* TODO:COPY careers-intro */}
        <div class="space-y-6 text-text-secondary leading-[1.9]">
          <p>novshiは少人数の会社です。定型業務はAIで効率化し、一人が採用支援と空き家再生の両方に関わります。</p>
          <p>九州の中小企業の採用を支える採用支援・BPOと、空き家を直して社宅に戻す不動産事業を手がけています。いまは立ち上げの途中です。現場に足を運び、必要なら自分で仕組みをつくれる人を探しています。</p>
        </div>

        <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-6 stagger">
          {[
            { icon: 'M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244', label: '採用と不動産、両方に関わる', desc: '採用支援と空き家再生の両方に関わり、事業の立ち上げを一気に経験できます。' },
            { icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z', label: '裁量の大きさ', desc: '少人数なので、提案から実行まで一人で持てます。意思決定が事業に直結します。' },
            { icon: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z', label: '福岡・熊本が現場', desc: '地場の経営者と直接会い、現場に足を運びながら進めます。' },
          ].map((item) => (
            <div class="bg-white p-8 rounded-xl border border-gray-200">
              <div class="w-10 h-10 rounded-lg bg-navy-50 flex items-center justify-center mb-5">
                <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <p class="text-sm font-bold text-gray-900 mb-2">{item.label}</p>
              <p class="text-xs text-text-secondary leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 lg:py-32 bg-bg-secondary">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-2xl fade-in-up">
        {/* TODO:COPY careers-positions */}
        <h2 class="text-2xl font-bold text-gray-900 mb-6">募集ポジション</h2>
        <p class="text-text-secondary mb-8">具体的な募集ポジションは準備中です。カジュアル面談はいつでも受け付けています。まずはお気軽にご連絡ください。</p>
        <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-white bg-accent rounded-lg hover:bg-accent-hover transition-colors duration-200">
          カジュアル面談を申し込む
        </a>
      </div>
    </div>
  </section>

  <CTASection title="novshiに興味がありますか？" subtitle="まずは一度、話しませんか。ポジションが決まっていなくても構いません。" />
</Layout>
