---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import CTASection from '../components/CTASection.astro';
import { IMG } from '../data/images';

const timelineItems = [
  { period: '—', company: '熊本県立熊本高校', role: '', detail: '' },
  { period: '—', company: '一橋大学 法学部法律学科', role: '', detail: '' },
  { period: '—', company: '総合商社', role: '事業投資', detail: '事業投資の実務を通じて、事業のつくり方を学ぶ' },
  { period: '—', company: '人材サービス大手', role: '中途採用の営業 → 求人検索サービスの事業企画', detail: '1,000社以上の採用に関わる' },
  { period: '—', company: 'スタートアップ', role: '人事・経営企画・事業開発', detail: 'エンジニア採用、組織づくり、経営企画を担当' },
  { period: '2025.10', company: '株式会社novshi 創業', role: '代表取締役', detail: '九州で、採用支援と空き家活用の二事業を立ち上げる' },
];
---

<Layout title="会社概要 | 株式会社novshi" description="株式会社novshiの会社概要、代表紹介、MVV。">
  <Hero title="会社概要" subtitle="九州の中小企業の採用と、空き家を使った住まいづくりを事業にしています。" compact={true} />

  <!-- Company Info -->
  <section class="sec-tight bg-white border-t border-gray-100 washi">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-3xl fade-in-up">
        <h2 class="text-xl font-bold text-gray-900 mb-8">基本情報</h2>
        <dl class="divide-y divide-gray-200">
          {[
            ['社名', '株式会社novshi（ノブシ）'],
            ['代表者', '大倉 佑介'],
            ['設立', '2025年10月'],
            ['所在地', '〒813-0017 福岡県福岡市東区香椎照葉6-2-51'],
            ['事業内容', '採用支援 / 組織・事業・経営の改善支援 / 空き家活用×社宅事業'],
            ['許認可', '有料職業紹介事業許可 40-ユ-301708'],
          ].map(([label, value]) => (
            <div class="flex flex-col sm:flex-row py-4 gap-1 sm:gap-0">
              <dt class="sm:w-1/4 text-xs font-medium text-text-muted tracking-wider">{label}</dt>
              <dd class="sm:w-3/4 text-sm text-gray-900">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- CEO Profile -->
  <section class="sec-xl bg-bg-secondary washi">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-16 items-start">
        <div class="fade-in-up">
          <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-3">大倉 佑介</h2>
          <p class="text-sm text-text-muted mb-3">Yusuke Okura — 代表取締役</p>
          <p class="text-sm text-gray-700 mb-12">1991年6月16日生まれ・熊本県出身</p>

          <div class="mb-14">
            <Timeline items={timelineItems} />
          </div>

          {/* TODO:COPY about-ceo-bio */}
          <div class="space-y-5 text-gray-700 leading-[1.9] text-[15px]">
            <p>総合商社での事業投資、人材サービス大手での<span class="font-num text-gray-900">1,000</span>社以上の採用支援、スタートアップでの人事・経営企画。これらの経験をもとに、2025年にnovshiを創業しました。</p>
            <p>九州の中小企業は、介護・建設・飲食といった生活を支える現場の雇い主です。その採用と定着を支える仕組みは、まだ十分に整っていません。</p>
            <p>求人を出すだけでは応募は集まりません。誰に何を届けるかを設計し、面接から入社後の定着まで一緒に進めます。外国人材には、空き家を直した社宅を用意し、住まいと仕事をまとめて支えます。</p>
          </div>
        </div>

        <!-- CEO portrait: 実写（撮り下ろし） -->
        <div class="flex flex-col gap-4 fade-in-up">
          <img src={IMG.aboutPortrait.webp} alt={IMG.aboutPortrait.alt} class="w-full aspect-[3/4] object-cover object-top" loading="lazy" width="1200" height="1800" />
        </div>
      </div>
    </div>
  </section>

  <!-- MVV -->
  <section class="sec-xl bg-white washi">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="space-y-20 lg:space-y-24">
        <!-- Mission: large typography -->
        <div class="fade-in-up">
          <p class="text-base font-bold text-gray-900 mb-6">ミッション</p>
          {/* TODO:COPY about-mission */}
          <h3 class="text-4xl lg:text-[3.5rem] lg:leading-[1.25] font-bold text-gray-900">
            豊かさの探究者である。
          </h3>
        </div>

        <!-- Vision: 少しサイズを落として階層をつける -->
        <div class="fade-in-up lg:pl-24">
          <p class="text-base font-bold text-gray-900 mb-6">ビジョン</p>
          {/* TODO:COPY about-vision */}
          <h3 class="text-2xl lg:text-[2.25rem] lg:leading-[1.3] font-bold text-gray-900">
            ひとつのモノサシで、価値が決まらない社会へ。
          </h3>
          <p class="mt-4 text-base lg:text-lg font-bold text-gray-500">Trust Your Own Way.</p>
        </div>

        <!-- Values: 均等3カラムカードをやめて行リストに -->
        <div class="fade-in-up">
          <p class="text-base font-bold text-gray-900 mb-8">バリュー</p>
          {/* TODO:COPY about-values */}
          <div class="border-t border-gray-200 max-w-3xl">
            {[
              { num: '01', value: 'あるものから始める。', en: 'Pockets First.', desc: '買う前に、雇う前に、つくる前に、すでに何を持っているかを見る。足すのは、そのあと。' },
              { num: '02', value: '多様な目で見る。', en: 'Whose Eyes?', desc: '価値は見る人との関係で決まる。暮らす人、働く人、経営者。目を増やすと、まだ名前のついていない良さが見つかる。' },
              { num: '03', value: '利益は、進むために。', en: 'Fuel, Not a Goal.', desc: '稼ぐことから逃げない。ただし燃料を積むことが目的になった時点で、進む先を見失う。' },
            ].map((item) => (
              <div class="grid grid-cols-[3rem_1fr] items-baseline gap-4 py-6 border-b border-gray-200">
                <span class="font-num text-2xl font-medium text-gray-300">{item.num}</span>
                <div>
                  <h4 class="text-base lg:text-lg font-bold text-gray-900 mb-1">{item.value}</h4>
                  <p class="text-sm font-bold text-gray-500 mb-2">{item.en}</p>
                  <p class="text-sm text-gray-700 leading-[1.9]">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand Belief: MVVを説明する散文（正本 novshi-hq/01_strategy/novshi_mvv_v1.0.md §6。本文は改変しない）
       組版: 本文 line-height 1.85 / letter-spacing 0.04em（tokens.md 本文規定 1.8 を詩として僅かに広げた範囲）。
       連の間隔を3段階（通常 / 転換 / 結び前）に分け、行間と連間の差でリズムを作る。均一な space-y は使わない。 -->
  <section class="sec-xl bg-bg-secondary washi">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-[40rem] fade-in-up">
        <img
          src="/images/brush/underline-kakishibu.png"
          alt=""
          aria-hidden="true"
          width="900"
          height="66"
          class="w-[88px] lg:w-[104px] h-auto mb-9 lg:mb-11 select-none"
        />

        <div
          class="text-[15px] lg:text-[17px] text-gray-900"
          style="line-height: 1.85; letter-spacing: 0.04em; word-break: keep-all; overflow-wrap: anywhere;"
        >
          <p class="text-[16px] lg:text-[19px]" style="line-height: 1.75;">足りないものを追う力は、社会を動かしてきた。</p>

          <p class="mt-[2.4em]">
            もっと便利に。もっと新しく。もっと大きく。<br />
            その力が、私たちの暮らしを豊かにしてきた。
          </p>

          <p class="mt-[2.4em]">ただ、追う先ばかり見ていると、手元にあるものが見えなくなる。</p>

          <p class="mt-[4.2em]">同じものでも、誰が見るかで価値は変わる。</p>

          <p class="mt-[2.4em]">
            ある人には必要のないものが、<br />
            別の誰かには、かけがえのないものになる。
          </p>

          <p class="mt-[4.2em]">価値がないのではない。</p>

          <p class="mt-[2.4em]">
            その価値に、まだ名前がついていないのかもしれない。<br />
            誰にとって価値になるのか、まだ分かっていないのかもしれない。<br />
            必要とする人に、まだ届いていないだけかもしれない。
          </p>

          <p class="mt-[4.2em]">
            だから私たちは、あるものを見る。<br />
            いろいろな目で見る。<br />
            そこにある良さを見つけ、名前をつけ、必要とする人へ届く形にする。
          </p>

          <p
            class="mt-[6em] text-[17px] lg:text-[21px]"
            style="line-height: 1.7; letter-spacing: 0.02em;"
          >
            新しい豊かさは、新しいものからしか生まれないわけではない。
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
