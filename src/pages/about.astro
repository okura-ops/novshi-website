---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import CTASection from '../components/CTASection.astro';
import { IMG } from '../data/images';

const timelineItems = [
  { period: '—', company: '一橋大学 法学部法律学科', role: '卒業', detail: '' },
  { period: '—', company: '丸紅株式会社', role: '事業投資', detail: '事業投資の実務を通じて、事業のつくり方を学ぶ' },
  { period: '—', company: '株式会社リクルート', role: '中途採用の営業 → Indeed事業の企画', detail: '1,000社以上の採用に関わる' },
  { period: '—', company: 'スタートアップ', role: '人事・経営企画・事業開発', detail: 'エンジニア採用、組織づくり、経営企画を担当' },
  { period: '2025.10', company: '株式会社novshi 創業', role: '代表取締役', detail: '九州で、採用支援と空き家再生の二事業を立ち上げる' },
];
---

<Layout title="会社概要 | 株式会社novshi" description="株式会社novshiの会社概要、代表紹介、MVV。">
  <Hero label="About" title="会社概要" subtitle="九州の中小企業の採用と、空き家を使った住まいづくりを事業にしています。" compact={true} />

  <!-- Company Info -->
  <section class="sec-tight bg-white border-t border-gray-100 washi">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="max-w-3xl fade-in-up">
        <h2 class="text-xl font-bold text-gray-900 mb-8">基本情報</h2>
        <dl class="divide-y divide-gray-200">
          {[
            ['社名', '株式会社novshi（ノブシ）'],
            ['代表者', '大倉 佑介'],
            ['設立', '2025年10月'],
            ['所在地', '〒813-0017 福岡県福岡市東区香椎照葉6-2-51'],
            ['事業内容', '採用支援 / 組織・事業・経営の改善支援 / 空き家再生×社宅事業'],
            ['許認可', '有料職業紹介事業許可 40-ユ-301708'],
          ].map(([label, value]) => (
            <div class="flex flex-col sm:flex-row py-4 gap-1 sm:gap-0">
              <dt class="sm:w-1/4 text-xs font-medium text-text-muted tracking-wider">{label}</dt>
              <dd class="sm:w-3/4 text-sm text-gray-900">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- CEO Profile -->
  <section class="sec-xl bg-bg-secondary washi">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-16 items-start">
        <div class="fade-in-up">
          <p class="eyebrow text-text-muted mb-5">CEO Profile</p>
          <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-3">大倉 佑介</h2>
          <p class="text-sm text-text-muted mb-3">Yusuke Okura — 代表取締役</p>
          <p class="text-sm text-text-secondary mb-12">1991年6月16日生まれ</p>

          <div class="mb-14">
            <Timeline items={timelineItems} />
          </div>

          {/* TODO:COPY about-ceo-bio */}
          <div class="space-y-5 text-text-secondary leading-[1.9] text-[15px]">
            <p>丸紅での事業投資、リクルートでの<span class="font-num text-gray-900">1,000</span>社以上の採用支援、スタートアップでの人事・経営企画。これらの経験をもとに、2025年にnovshiを創業しました。</p>
            <p>九州の中小企業は、介護・建設・飲食といった生活を支える現場の雇い主です。その採用と定着を支える仕組みは、まだ十分に整っていません。</p>
            <p>求人を出すだけでは応募は集まりません。誰に何を届けるかを設計し、面接から入社後の定着まで一緒に進めます。外国人材には、空き家を直した社宅を用意し、住まいと仕事をまとめて支えます。</p>
          </div>
        </div>

        <!-- CEO portrait: 実写（撮り下ろし） -->
        <div class="flex flex-col gap-4 fade-in-up lg:sticky lg:top-24">
          <img src={IMG.aboutPortrait.webp} alt={IMG.aboutPortrait.alt} class="w-full aspect-[3/4] object-cover" loading="lazy" width="1200" height="1600" />
        </div>
      </div>
    </div>
  </section>

  <!-- MVV -->
  <section class="sec-xl bg-white washi">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="space-y-20 lg:space-y-24">
        <!-- Mission: large typography -->
        <div class="fade-in-up">
          <p class="eyebrow text-text-muted mb-6">Mission</p>
          {/* TODO:COPY about-mission */}
          <h3 class="text-4xl lg:text-[3.5rem] lg:leading-[1.25] font-bold text-gray-900">
            豊かさを、描きなおす。
          </h3>
        </div>

        <!-- Vision: 少しサイズを落として階層をつける -->
        <div class="fade-in-up lg:pl-24">
          <p class="eyebrow text-text-muted mb-6">Vision</p>
          {/* TODO:COPY about-vision */}
          <h3 class="text-2xl lg:text-[2.25rem] lg:leading-[1.3] font-bold text-gray-900">
            九州に、人が来る理由を<span class="whitespace-nowrap"><span class="font-num">1,000</span>つくる。</span>
          </h3>
        </div>

        <!-- Values: 均等3カラムカードをやめて行リストに -->
        <div class="fade-in-up">
          <p class="eyebrow text-text-muted mb-8">Values</p>
          {/* TODO:COPY about-values */}
          <div class="border-t border-gray-200 max-w-3xl">
            {[
              { num: '01', value: '志ドリブン', desc: '利益ではなく志が意思決定の起点。何のためにやるのかを常に問い続ける。' },
              { num: '02', value: '見えにくい価値を、見に行く', desc: '数字だけでなく、現場の声や背景にある課題まで見に行く。' },
              { num: '03', value: '利益は燃料、目的地ではない', desc: '利益は事業を続けるための手段であって、目的ではない。' },
            ].map((item) => (
              <div class="grid grid-cols-[3rem_1fr] items-baseline gap-4 py-6 border-b border-gray-200">
                <span class="font-num text-2xl font-medium text-gray-300">{item.num}</span>
                <div>
                  <h4 class="text-base lg:text-lg font-bold text-gray-900 mb-1">{item.value}</h4>
                  <p class="text-sm text-text-secondary leading-[1.9]">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
