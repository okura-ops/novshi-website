---
interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = 'まずはお気軽にご相談ください',
  subtitle = 'サービスに関するご質問・ご相談は無料で承っております。',
} = Astro.props;
---

<section class="relative py-24 lg:py-32 bg-navy-900 overflow-hidden">
  <!-- Mesh gradient background -->
  <div class="absolute inset-0 opacity-40"
       style="background-image: radial-gradient(ellipse at 30% 50%, rgba(42, 90, 143, 0.5) 0%, transparent 50%), radial-gradient(ellipse at 70% 30%, rgba(30, 58, 95, 0.4) 0%, transparent 50%);">
  </div>

  <div class="relative z-10 max-w-2xl mx-auto px-5 sm:px-8 text-center fade-in-up">
    <h2 class="text-2xl lg:text-3xl font-bold text-white">{title}</h2>
    <p class="mt-4 text-navy-200 text-base">{subtitle}</p>
    <a
      href="/contact"
      class="inline-flex items-center justify-center mt-8 px-8 py-4 text-sm font-semibold text-navy-900 bg-white rounded-lg hover:bg-gray-100 transition-colors duration-200"
    >
      お問い合わせ
    </a>
  </div>
</section>
