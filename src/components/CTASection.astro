---
interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = 'まずはお気軽にご相談ください',
  subtitle = 'サービスの内容や進め方について、遠慮なくお尋ねください。',
} = Astro.props;
---

<section class="py-24 lg:py-32 bg-[#1A1A1A] relative overflow-hidden">
  <img aria-hidden="true" src="/images/brush/wave-white.png" alt="" width="1100" height="474" class="absolute -left-[6%] -bottom-[24%] w-[70%] max-w-none opacity-[0.09] select-none pointer-events-none" loading="lazy" />
  <div class="relative max-w-2xl mx-auto px-5 sm:px-8 text-center fade-in-up">
    {/* TODO:COPY cta-section */}
    <h2 class="text-2xl lg:text-3xl font-bold text-white">{title}</h2>
    <p class="mt-4 text-white/60 text-base">{subtitle}</p>
    <a
      href="/contact"
      class="inline-flex items-center justify-center mt-8 px-8 py-4 text-sm font-semibold text-[#1A1A1A] bg-white rounded-none hover:opacity-85 transition-opacity duration-200"
    >
      お問い合わせ
    </a>
  </div>
</section>
