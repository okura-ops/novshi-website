<form id="contact-form" class="space-y-8" method="POST">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="company" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">会社名<span class="text-gray-400 normal-case tracking-normal ml-1">（任意）</span></label>
      <input type="text" id="company" name="company" class="w-full px-0 py-3 border-0 border-b border-gray-200 text-sm bg-transparent focus:outline-none focus:border-gray-900 transition-colors duration-200 placeholder:text-gray-300" placeholder="株式会社〇〇" />
    </div>
    <div>
      <label for="name" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">お名前</label>
      <input type="text" id="name" name="name" required class="w-full px-0 py-3 border-0 border-b border-gray-200 text-sm bg-transparent focus:outline-none focus:border-gray-900 transition-colors duration-200 placeholder:text-gray-300" placeholder="山田 太郎" />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="email" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">メールアドレス</label>
      <input type="email" id="email" name="email" required class="w-full px-0 py-3 border-0 border-b border-gray-200 text-sm bg-transparent focus:outline-none focus:border-gray-900 transition-colors duration-200 placeholder:text-gray-300" placeholder="example@company.co.jp" />
    </div>
    <div>
      <label for="phone" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">電話番号<span class="text-gray-400 normal-case tracking-normal ml-1">（任意）</span></label>
      <input type="tel" id="phone" name="phone" class="w-full px-0 py-3 border-0 border-b border-gray-200 text-sm bg-transparent focus:outline-none focus:border-gray-900 transition-colors duration-200 placeholder:text-gray-300" placeholder="090-1234-5678" />
    </div>
  </div>

  <div>
    <label for="type" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">お問い合わせ種別</label>
    <select id="type" name="type" required class="w-full px-0 py-3 border-0 border-b border-gray-200 text-sm bg-transparent focus:outline-none focus:border-gray-900 transition-colors duration-200 text-gray-900">
      <option value="" disabled selected class="text-gray-300">選択してください</option>
      <option value="service">サービスについて</option>
      <option value="recruit">採用について</option>
      <option value="other">その他</option>
    </select>
  </div>

  <div>
    <label for="message" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">メッセージ</label>
    <textarea id="message" name="message" required rows="5" class="w-full px-0 py-3 border-0 border-b border-gray-200 text-sm bg-transparent focus:outline-none focus:border-gray-900 transition-colors duration-200 resize-y placeholder:text-gray-300" placeholder="ご質問・ご相談内容をお書きください"></textarea>
  </div>

  <div>
    <button type="submit" class="inline-flex items-center justify-center px-8 py-4 text-sm font-semibold text-white bg-accent rounded-lg hover:bg-accent-hover transition-colors duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
      送信する
    </button>
  </div>

  <div id="form-success" class="hidden py-12 text-center">
    <h3 class="text-xl font-bold text-gray-900">メールソフトを起動しました</h3>
    <p class="mt-3 text-text-secondary text-sm">
      入力内容を差し込んだメールの下書きが開きます。内容をご確認のうえ、そのまま送信してください。<br />
      起動しない場合は、お手数ですが <a href="mailto:okura@novshi.co.jp" class="text-gray-900 underline underline-offset-4">okura@novshi.co.jp</a> 宛に直接ご連絡ください。
    </p>
  </div>
</form>

<script>
  // mailto ハイブリッド：フォームUIはそのまま、送信は既定メーラーで okura@novshi.co.jp 宛に下書きを開く。
  // サーバー不要（Formspree等の外部依存なし）。入力内容を件名・本文へ差し込む。
  const CONTACT_TO = 'okura@novshi.co.jp';
  const TYPE_LABELS: Record<string, string> = {
    service: 'サービスについて',
    recruit: '採用について',
    other: 'その他',
  };

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const company = (data.get('company') as string || '').trim();
    const name = (data.get('name') as string || '').trim();
    const email = (data.get('email') as string || '').trim();
    const phone = (data.get('phone') as string || '').trim();
    const typeVal = (data.get('type') as string || '').trim();
    const typeLabel = TYPE_LABELS[typeVal] || typeVal;
    const message = (data.get('message') as string || '').trim();

    const subject = `【お問い合わせ】${typeLabel}${company ? '／' + company : ''}${name ? '（' + name + '）' : ''}`;
    const body = [
      '株式会社novshi ご担当者さま',
      '',
      'Webサイトのお問い合わせフォームより送信します。',
      '',
      `お問い合わせ種別：${typeLabel}`,
      `会社名：${company || '（未入力）'}`,
      `お名前：${name}`,
      `メールアドレス：${email}`,
      `電話番号：${phone || '（未入力）'}`,
      '',
      '── お問い合わせ内容 ──',
      message,
      '',
    ].join('\r\n');

    const mailto = `mailto:${CONTACT_TO}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;

    // メーラーが開いたら完了表示に切り替える
    form.querySelectorAll('input, select, textarea, button, label, .grid, div:not(#form-success)').forEach((el) => { (el as HTMLElement).style.display = 'none'; });
    success.classList.remove('hidden');
  });
</script>
