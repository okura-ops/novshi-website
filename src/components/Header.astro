---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/services', label: 'サービス' },
  { href: '/about', label: '会社概要' },
  { href: '/careers', label: '採用情報' },
  { href: '/contact', label: 'お問い合わせ' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" data-header>
  <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16 lg:h-[72px]">
      <!-- Logo: switches between white (on dark hero) and dark -->
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="header-logo-text text-xl lg:text-[22px] font-bold tracking-tight transition-colors duration-300" style="font-family: 'Montserrat', sans-serif;">novshi</span>
      </a>

      <nav class="hidden md:flex items-center gap-10">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'header-nav-link text-[13px] font-medium tracking-wide transition-colors duration-300',
              currentPath === item.href || currentPath === item.href + '/'
                ? 'is-active'
                : '',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <button id="mobile-menu-btn" class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-[5px]" aria-label="メニュー" aria-expanded="false">
        <span class="header-bar block w-5 h-[1.5px] transition-all duration-300 origin-center" id="bar1"></span>
        <span class="header-bar block w-5 h-[1.5px] transition-all duration-300" id="bar2"></span>
        <span class="header-bar block w-5 h-[1.5px] transition-all duration-300 origin-center" id="bar3"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden fixed inset-0 top-16 bg-white z-40 hidden">
    <nav class="flex flex-col items-center gap-8 pt-24">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-base font-medium tracking-wide transition-colors duration-200',
            currentPath === item.href || currentPath === item.href + '/' ? 'text-gray-900' : 'text-gray-500 hover:text-gray-900',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<div class="h-16 lg:h-[72px]"></div>

<style>
  /* Default state: dark text (for light pages) */
  .header-logo-text { color: var(--color-gray-900); }
  .header-nav-link { color: var(--color-gray-500); }
  .header-nav-link:hover, .header-nav-link.is-active { color: var(--color-gray-900); }
  .header-bar { background-color: var(--color-gray-900); }

  /* Over dark hero: white text */
  [data-header].is-over-hero .header-logo-text { color: #fff; }
  [data-header].is-over-hero .header-nav-link { color: rgba(255,255,255,0.6); }
  [data-header].is-over-hero .header-nav-link:hover,
  [data-header].is-over-hero .header-nav-link.is-active { color: #fff; }
  [data-header].is-over-hero .header-bar { background-color: #fff; }

  /* Scrolled state: solid white bg (always dark text) */
  [data-header].is-scrolled .header-logo-text { color: var(--color-gray-900); }
  [data-header].is-scrolled .header-nav-link { color: var(--color-gray-500); }
  [data-header].is-scrolled .header-nav-link:hover,
  [data-header].is-scrolled .header-nav-link.is-active { color: var(--color-gray-900); }
  [data-header].is-scrolled .header-bar { background-color: var(--color-gray-900); }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const mobileMenuBtn = document.getElementById('mobile-menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const bar1 = document.getElementById('bar1')!;
  const bar2 = document.getElementById('bar2')!;
  const bar3 = document.getElementById('bar3')!;
  let menuOpen = false;

  // Check if page has a dark hero
  const darkHero = document.querySelector('[data-hero-dark]');

  function updateHeader() {
    const scrolled = window.scrollY > 10;

    if (scrolled) {
      header.classList.add('is-scrolled', 'bg-white/90', 'backdrop-blur-md', 'border-b', 'border-gray-200/60');
      header.classList.remove('is-over-hero');
    } else {
      header.classList.remove('is-scrolled', 'bg-white/90', 'backdrop-blur-md', 'border-b', 'border-gray-200/60');
      if (darkHero) {
        header.classList.add('is-over-hero');
      }
    }
  }

  // Initialize
  updateHeader();
  window.addEventListener('scroll', updateHeader);

  mobileMenuBtn.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenu.classList.toggle('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', String(menuOpen));
    bar1.style.transform = menuOpen ? 'rotate(45deg) translate(2px, 2px)' : '';
    bar2.style.opacity = menuOpen ? '0' : '';
    bar3.style.transform = menuOpen ? 'rotate(-45deg) translate(2px, -2px)' : '';
    document.body.style.overflow = menuOpen ? 'hidden' : '';

    // When mobile menu opens, force dark text
    if (menuOpen) {
      header.classList.remove('is-over-hero');
      header.classList.add('bg-white');
    } else {
      header.classList.remove('bg-white');
      updateHeader();
    }
  });

  mobileMenu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuOpen = false;
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
      bar1.style.transform = '';
      bar2.style.opacity = '';
      bar3.style.transform = '';
      document.body.style.overflow = '';
      header.classList.remove('bg-white');
      updateHeader();
    });
  });
</script>
