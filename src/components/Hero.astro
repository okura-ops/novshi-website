---
import { IMG } from '../data/images';

interface Props {
  title: string;
  subtitle?: string;
  showCTA?: boolean;
  compact?: boolean;
  /** 下層ページ用: 欧文セクションラベル */
  label?: string;
}

const { title, subtitle, showCTA = false, compact = false, label } = Astro.props;

const hero = IMG.heroEngawa;
const srcset = (hero.widths || [])
  .map((w, i) => (i === 0 ? `${hero.webp} ${w}w` : `${hero.webp.replace('.webp', `-${w}.webp`)} ${w}w`))
  .join(', ');
---

{compact ? (
  <!-- Compact hero for sub-pages (light background) -->
  <section class="pt-14 pb-16 lg:pt-20 lg:pb-24 bg-white">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      {label && <p class="eyebrow text-text-muted mb-5 fade-in-up">{label}</p>}
      <h1 class="text-[1.75rem] lg:text-[2.5rem] font-bold text-gray-900 fade-in-up">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-5 lg:mt-6 text-text-secondary max-w-xl text-base fade-in-up">
          {subtitle}
        </p>
      )}
    </div>
  </section>
) : (
  <!-- Homepage hero: 白地の非対称分割（テキスト5 : 写真7・右端まで断ち落とし）.
       Re Loop型を参照（Phase 1ベンチマーク）。写真を背景に敷かず、角版で立てる.
       確定: 見出し=Zen Kaku Gothic New / CTA=黒（A1×B1・2026-08-03） -->
  <section class="bg-white">
    <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
      <div class="order-2 lg:order-1 lg:col-span-5 flex flex-col justify-center px-5 sm:px-8 lg:pl-[max(2rem,calc((100vw-1120px)/2))] lg:pr-14 pt-10 pb-16 lg:py-20">
        <p class="eyebrow text-text-muted mb-6 fade-in-up">Kyushu / Work &amp; Live</p>

        <h1
          class="text-[2.4rem] leading-[1.3] sm:text-[2.75rem] lg:text-[3.25rem] lg:leading-[1.35] font-bold text-gray-900 fade-in-up"
          style="word-break: keep-all;"
        >
          {title}
        </h1>

        {subtitle && (
          <p class="mt-6 lg:mt-7 text-base text-text-secondary max-w-md leading-[1.9] fade-in-up">
            {subtitle}
          </p>
        )}

        {showCTA && (
          <div class="mt-9 flex flex-wrap gap-3 fade-in-up">
            <a
              href="/services"
              class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-white bg-[#1A1A1A] rounded-md hover:opacity-85 transition-opacity duration-200"
            >
              サービスを見る
            </a>
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-gray-900 border border-gray-900 rounded-md hover:bg-[#F2F2F2] transition-colors duration-200"
            >
              お問い合わせ
            </a>
          </div>
        )}
      </div>

      <div class="order-1 lg:order-2 lg:col-span-7 relative">
        <picture>
          <source type="image/webp" srcset={srcset} sizes="(min-width: 1024px) 58vw, 100vw" />
          <img
            src={hero.jpg}
            alt={hero.alt}
            class="w-full h-[300px] sm:h-[380px] lg:h-[78vh] lg:min-h-[540px] object-cover"
            fetchpriority="high"
            width="1920"
            height="1440"
          />
        </picture>
        <p class="absolute bottom-0 left-0 bg-[#1A1A1A] text-white/80 text-[11px] px-4 py-2">
          保有物件（福岡県遠賀町）— 再生前
        </p>
      </div>
    </div>
  </section>
)}
