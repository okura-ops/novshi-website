---
interface Props {
  title: string;
  subtitle?: string;
  showCTA?: boolean;
  compact?: boolean;
}

const { title, subtitle, showCTA = false, compact = false } = Astro.props;
---

{compact ? (
  <!-- Compact hero for sub-pages (light background) -->
  <section class="pt-16 pb-20 lg:pt-20 lg:pb-28">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <h1 class="text-2xl lg:text-[2.25rem] font-bold text-gray-900 fade-in-up">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-5 lg:mt-6 text-text-secondary max-w-xl text-base fade-in-up">
          {subtitle}
        </p>
      )}
    </div>
  </section>
) : (
  <!-- Homepage hero: light split layout with Kyushu photo + cartographic map overlay -->
  <section class="relative overflow-hidden bg-white">
    <div class="relative max-w-[1120px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-center min-h-[80vh] py-20 lg:py-28">

        <!-- Text side -->
        <div class="relative">
          <!-- Large "志" watermark (left side only) -->
          <div
            aria-hidden="true"
            class="hero-kanji-watermark pointer-events-none select-none absolute -left-4 lg:-left-12 top-0 lg:top-4 text-[11rem] lg:text-[16rem] leading-none font-medium text-accent/[0.045]"
            style="font-family: 'Noto Serif JP', serif;"
          >志</div>

          <div class="relative z-10">
            <p class="text-[11px] lg:text-xs font-medium text-accent tracking-[0.3em] uppercase mb-6 fade-in-up" style="font-family: 'Noto Serif JP', serif;">
              Kyushu × Essential Workers × AI
            </p>

            <h1 class="text-[2.25rem] leading-[1.15] sm:text-[2.75rem] lg:text-[3.25rem] lg:leading-[1.1] font-bold text-gray-900 fade-in-up tracking-tight">
              {title}
            </h1>

            {subtitle && (
              <p class="mt-6 lg:mt-8 text-base lg:text-lg text-text-secondary max-w-xl leading-relaxed fade-in-up">
                {subtitle}
              </p>
            )}

            {showCTA && (
              <div class="mt-9 lg:mt-10 flex flex-wrap gap-3 fade-in-up">
                <a
                  href="/services"
                  class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-white bg-accent rounded-md hover:bg-accent-hover transition-colors duration-200"
                >
                  サービスを見る
                </a>
                <a
                  href="/contact"
                  class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-gray-900 border border-gray-300 rounded-md hover:border-gray-900 transition-colors duration-200"
                >
                  お問い合わせ
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- Image side with cartographic map overlay -->
        <div class="relative aspect-[4/5] lg:aspect-[5/6] rounded-2xl overflow-hidden fade-in-up bg-gray-100">
          <!-- Photo -->
          <picture>
            <source
              srcset="/images/hero-kyushu-sm.webp 960w, /images/hero-kyushu.webp 1920w"
              type="image/webp"
              sizes="(min-width: 1024px) 50vw, 100vw"
            />
            <img
              src="/images/hero-kyushu.jpg"
              alt="九州・阿蘇の早朝風景"
              width="1920"
              height="1080"
              loading="eager"
              fetchpriority="high"
              class="hero-photo absolute inset-0 w-full h-full object-cover"
            />
          </picture>

          <!-- Navy gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-br from-navy-900/20 via-navy-900/45 to-navy-900/70"></div>

          <!-- Cartographic Kyushu map (processed PNG + screen blend) -->
          <div class="absolute inset-0 flex items-center justify-center p-6 lg:p-10">
            <div class="relative w-full max-w-[380px] lg:max-w-[440px] aspect-[800/678]">
              <img
                src="/images/kyushu-map-processed.png"
                alt=""
                aria-hidden="true"
                class="kyushu-cartographic absolute inset-0 w-full h-full object-contain"
              />
              <!-- City pins overlay (positions in % of the map image) -->
              <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 800 678" aria-hidden="true">
                <!-- Fukuoka pin -->
                <g>
                  <circle cx="375" cy="105" r="14" fill="none" stroke="#FAF8F5" stroke-width="1" opacity="0.35">
                    <animate attributeName="r" values="10;22;22" dur="3s" repeatCount="indefinite"/>
                    <animate attributeName="opacity" values="0.5;0;0" dur="3s" repeatCount="indefinite"/>
                  </circle>
                  <circle cx="375" cy="105" r="6" fill="#FAF8F5"/>
                  <text x="395" y="100" fill="#FAF8F5" font-family="'Noto Sans JP', sans-serif" font-size="22" font-weight="600">福岡</text>
                  <text x="395" y="120" fill="#FAF8F5" opacity="0.7" font-family="Inter, sans-serif" font-size="13" letter-spacing="2">FUKUOKA</text>
                </g>
                <!-- Kumamoto pin -->
                <g>
                  <circle cx="350" cy="330" r="14" fill="none" stroke="#FAF8F5" stroke-width="1" opacity="0.35">
                    <animate attributeName="r" values="10;22;22" dur="3s" begin="1.5s" repeatCount="indefinite"/>
                    <animate attributeName="opacity" values="0.5;0;0" dur="3s" begin="1.5s" repeatCount="indefinite"/>
                  </circle>
                  <circle cx="350" cy="330" r="6" fill="#FAF8F5"/>
                  <text x="370" y="325" fill="#FAF8F5" font-family="'Noto Sans JP', sans-serif" font-size="22" font-weight="600">熊本</text>
                  <text x="370" y="345" fill="#FAF8F5" opacity="0.7" font-family="Inter, sans-serif" font-size="13" letter-spacing="2">KUMAMOTO</text>
                </g>
                <!-- Connecting dashed line -->
                <line x1="375" y1="115" x2="350" y2="320" stroke="#FAF8F5" stroke-width="1" opacity="0.35" stroke-dasharray="4 4"/>
              </svg>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom section separator -->
    <div class="absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-b from-transparent to-bg-secondary/40 pointer-events-none"></div>
  </section>
)}

<style>
  .hero-photo {
    filter: grayscale(1) contrast(1.05) brightness(0.96);
  }

  /* Cartographic map: dark PNG → light outline via screen blend */
  .kyushu-cartographic {
    mix-blend-mode: screen;
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo { filter: grayscale(1); }
  }
</style>
