---
interface Props {
  title: string;
  subtitle?: string;
  showCTA?: boolean;
  compact?: boolean;
}

const { title, subtitle, showCTA = false, compact = false } = Astro.props;
---

{compact ? (
  <!-- Compact hero for sub-pages (light background) -->
  <section class="pt-16 pb-20 lg:pt-20 lg:pb-28 bg-white">
    <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
      <h1 class="text-2xl lg:text-[2.25rem] font-bold text-gray-900 fade-in-up">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-5 lg:mt-6 text-text-secondary max-w-xl text-base fade-in-up">
          {subtitle}
        </p>
      )}
    </div>
  </section>
) : (
  <!-- Homepage hero: dark editorial full-bleed (monotone v4).
       data-hero-dark → Header overlays with white text (see Header.astro).
       Negative top margin cancels the fixed-header spacer so the hero sits
       behind the transparent header (starts at y=0). -->
  <section data-hero-dark class="relative overflow-hidden bg-[#1A1A1A] -mt-16 lg:-mt-[72px]">
    <!-- 「志」 watermark: monotone, low opacity -->
    <span
      aria-hidden="true"
      class="pointer-events-none select-none absolute right-[1%] -bottom-[8%] text-[16rem] sm:text-[24rem] lg:text-[34rem] leading-none text-white/[0.055]"
      style="font-family: 'Noto Serif JP', serif;"
    >志</span>

    <div class="relative z-10 max-w-[1120px] mx-auto px-5 sm:px-8 min-h-[88vh] flex flex-col justify-center pt-28 pb-24 lg:pt-32 lg:pb-28">
      <p class="text-[11px] lg:text-xs font-medium text-white/90 tracking-[0.3em] mb-6 fade-in-up" style="font-family: 'Noto Serif JP', serif;">
        採用支援と空き家再生 ｜ 九州
      </p>

      <h1
        class="text-[2.5rem] leading-[1.12] sm:text-[3rem] lg:text-[4.25rem] lg:leading-[1.1] font-bold text-white tracking-tight fade-in-up"
        style="word-break: keep-all;"
      >
        {title}
      </h1>

      {subtitle && (
        <p class="mt-7 lg:mt-8 text-base lg:text-lg text-white/80 max-w-xl leading-relaxed fade-in-up">
          {subtitle}
        </p>
      )}

      {showCTA && (
        <div class="mt-9 lg:mt-11 flex flex-wrap gap-3 fade-in-up">
          <a
            href="/services"
            class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-[#1A1A1A] bg-white rounded-md hover:opacity-85 transition-opacity duration-200"
          >
            サービスを見る
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-white border border-white/40 rounded-md hover:bg-white/10 transition-colors duration-200"
          >
            お問い合わせ
          </a>
        </div>
      )}
    </div>
  </section>
)}
