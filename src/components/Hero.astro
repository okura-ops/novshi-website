---
interface Props {
  title: string;
  /** トップ用: 見出し2行目（円相との衝突を避けるため明示改行） */
  title2?: string;
  subtitle?: string;
  showCTA?: boolean;
  compact?: boolean;
  /** 下層ページ用: 欧文セクションラベル */
  label?: string;
}

const { title, title2, subtitle, showCTA = false, compact = false, label } = Astro.props;
---

{compact ? (
  <!-- Compact hero for sub-pages (light background) -->
  <section class="pt-14 pb-16 lg:pt-20 lg:pb-24 bg-white washi relative overflow-hidden">
    <img aria-hidden="true" src="/images/brush/enso-6.png" alt="" width="1200" height="1213" class="absolute -right-[14%] -top-[40%] w-[420px] lg:w-[520px] max-w-none opacity-[0.05] select-none pointer-events-none" loading="lazy" />
    <div class="relative max-w-[1120px] mx-auto px-5 sm:px-8">
      {label && <p class="eyebrow text-text-muted mb-5 fade-in-up">{label}</p>}
      <h1 class="text-[1.75rem] lg:text-[2.5rem] font-bold text-gray-900 fade-in-up">
        {title}
      </h1>
      <img src="/images/brush/underline-kakishibu.png" alt="" aria-hidden="true" width="900" height="66" class="w-[150px] lg:w-[180px] h-auto mt-3 fade-in-up select-none" />
      {subtitle && (
        <p class="mt-5 lg:mt-6 text-gray-700 max-w-xl text-base fade-in-up">
          {subtitle}
        </p>
      )}
    </div>
  </section>
) : (
  <!-- Homepage hero: 円相グラフィック型（2026-08-03大倉確定）.
       ロゴマーク実物（筆致の円相＋刀の貫き）を右に断ち切りで特大配置。写真は使わない.
       書体=Zen Kaku Gothic New / CTA=黒（A1×B1確定） -->
  <section class="relative bg-white overflow-hidden washi">
    <img
      aria-hidden="true"
      src="/images/site/mark-enso-black.png"
      alt=""
      width="888"
      height="981"
      class="absolute -right-[24vw] lg:-right-[10vw] top-1/2 -translate-y-1/2 w-[80vw] lg:w-[50vw] max-w-none select-none pointer-events-none opacity-[0.08] lg:opacity-100"
      fetchpriority="high"
    />

    <div class="relative z-10 max-w-[1120px] mx-auto px-5 sm:px-8 min-h-[74vh] lg:min-h-[82vh] flex flex-col justify-center py-20">
      <p class="eyebrow text-text-muted mb-7 fade-in-up">Kyushu / Work &amp; Live</p>

      <h1
        class="text-[2.6rem] leading-[1.3] sm:text-[3.25rem] lg:text-[4.25rem] lg:leading-[1.25] font-bold text-gray-900 fade-in-up"
        style="word-break: keep-all;"
      >
        {title}{title2 && <><br />{title2}</>}
      </h1>
      <img src="/images/brush/underline-kakishibu.png" alt="" aria-hidden="true" width="900" height="66" class="w-[210px] lg:w-[250px] h-auto mt-4 fade-in-up select-none" />

      {subtitle && (
        <p class="mt-7 text-base lg:text-lg text-gray-700 max-w-lg leading-[1.9] fade-in-up">
          {subtitle}
        </p>
      )}

      {showCTA && (
        <div class="mt-10 flex flex-wrap gap-3 fade-in-up">
          <a
            href="/services"
            class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-white bg-[#1A1A1A] rounded-none hover:opacity-85 transition-opacity duration-200"
          >
            サービスを見る
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-gray-900 border border-gray-900 rounded-none hover:bg-[#F2F2F2] transition-colors duration-200"
          >
            お問い合わせ
          </a>
        </div>
      )}
    </div>
  </section>
)}
